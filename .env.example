# Example env — copy to .env before local run
CORTEX_URL=http://127.0.0.1:8010
OPENVAULT_URL=http://127.0.0.1:5000
CORTEX_ENGINE_IMAGE=ghcr.io/netie/cortex:2.5.0-core
DATABASE_URL=postgresql://dms:dms@127.0.0.1:5432/dms
# Product default = live (Cortex mint→bind→ask). demo = offline fallback only.
DMS_ASK_MODE=live
DMS_DEMO_FALLBACK=0
DMS_TENANT_ID=aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
DMS_ACTOR_USER_ID=bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Live smoke: python scripts/smoke_live_ask.py
# Local UI+API: docker compose --profile dev up postgres api_dev
# Appliance: build UI dist, then docker compose up (Caddy :8080 only public)

# Warehouse identity (S4). Ingest writes DMS_WAREHOUSE_DB. Chat reads
# CORTEX_WAREHOUSE_DB (swap: point the engine at the same file and sync is a
# no-op; until then run python scripts/sync_bronze_to_serving.py after upload).
# Do not point DMS_WAREHOUSE_DB at the Cortex file — demo seed uses
# txn_type=outbound, the engine file uses OUT, and ensure_demo_warehouse reseeds.
# DMS_WAREHOUSE_DB=
# CORTEX_WAREHOUSE_DB=
# CORTEX_HOME=D:\Cortex

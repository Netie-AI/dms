.env
# .venv* not .venv: an audit venv named .venv_audit slipped past the exact
# match and put pip.exe plus 3,237 lines of vendored licences on a branch.
.venv*/
venv/
# Local pytest / scratch output. Never a release artifact, never reviewable.
.tmp/
__pycache__/
*.pyc
node_modules/
.next/
data/
*.duckdb
.DS_Store
dist/
build/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.pytest_cache/
deploy/compose/.env
*.egg-info/
.eggs/
contract/openapi-1.1.0.gen.json

vendor/

# Cloned benchmark corpora (CRAG, open_ragbench) - fetched, never vendored
tests/repos/
logs/
*.err.log
*.out.log
.claude/worktrees/

# Local sample databases + scratch documents. Binaries never go in git (not LFS
# either) - GitHub Releases for installers, GHCR for images.
*.bak
/*.pdf

# Per-session scratch: `gh issue create --body-file` bodies. The ticket lives in
# GitHub, never as a markdown file in the repo (Netie R-0013: no per-session files).
/issue*_body.md

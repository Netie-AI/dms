{
  "openapi": "3.1.0",
  "info": {
    "title": "Cortex Engine HTTP API",
    "version": "1.0.0",
    "description": "cortex-contract 1.0.0 wire format. DMS generates packages/cortex_client from this file. Engine image tag floats underneath."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8010",
      "description": "Local Cortex engine"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Engine liveness",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/answer": {
      "post": {
        "operationId": "answer",
        "summary": "Ask the answer engine",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ledger/append": {
      "post": {
        "operationId": "ledger_append",
        "summary": "Append an entry to the Cortex ledger (single hash chain)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LedgerAppendRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Appended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerAppendResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status", "contract", "engine"],
        "properties": {
          "status": { "type": "string", "examples": ["ok"] },
          "contract": { "type": "string", "examples": ["1.0.0"] },
          "engine": { "type": "string", "examples": ["2.5.0"] }
        }
      },
      "AnswerRequest": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "question": { "type": "string" },
          "space_id": { "type": "string", "nullable": true },
          "tenant_id": { "type": "string", "nullable": true }
        }
      },
      "AnswerResponse": {
        "type": "object",
        "required": ["answer", "abstained"],
        "properties": {
          "answer": { "type": "string", "nullable": true },
          "abstained": { "type": "boolean" },
          "receipt_id": { "type": "string", "nullable": true }
        }
      },
      "LedgerAppendRequest": {
        "type": "object",
        "required": ["event_type", "payload"],
        "properties": {
          "event_type": { "type": "string" },
          "payload": { "type": "object", "additionalProperties": true },
          "actor": { "type": "string", "nullable": true }
        }
      },
      "LedgerAppendResponse": {
        "type": "object",
        "required": ["entry_id", "hash"],
        "properties": {
          "entry_id": { "type": "string" },
          "hash": { "type": "string" }
        }
      }
    }
  }
}

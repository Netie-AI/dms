{
  "openapi": "3.1.0",
  "info": {
    "title": "Cortex Contract API",
    "version": "1.5.0",
    "description": "Pruned generation surface \u2014 five contract operationIds only."
  },
  "paths": {
    "/v1/contract/ask": {
      "post": {
        "description": "Answer a governed question (DMS ask plane). Requires a prior submit bind.",
        "operationId": "ask",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContractAskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractAnswer"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Contract Ask",
        "tags": [
          "contract"
        ]
      }
    },
    "/v1/contract/drillthrough": {
      "post": {
        "description": "Re-derive contributing rows under the same session manifest (T7).",
        "operationId": "drillthrough",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContractDrillthroughRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractDrillthroughResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Contract Drillthrough",
        "tags": [
          "contract"
        ]
      }
    },
    "/v1/contract/ledger/append": {
      "post": {
        "operationId": "ledger.append",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LedgerAppendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractLedgerEntry"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Contract Ledger Append",
        "tags": [
          "contract"
        ]
      }
    },
    "/v1/contract/ledger/verify": {
      "post": {
        "operationId": "ledger.verify",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LedgerVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractChainVerification"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Contract Ledger Verify",
        "tags": [
          "contract"
        ]
      }
    },
    "/v1/contract/submit": {
      "post": {
        "description": "Submit a plan under a signed session manifest (C4).",
        "operationId": "submit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContractSubmitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractQueryResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Contract Submit",
        "tags": [
          "contract"
        ]
      }
    },
    "/v1/contract/tools": {
      "get": {
        "description": "List tools DMS may invoke through the contract runtime.",
        "operationId": "tool.registry",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolRegistryResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Contract Tool Registry",
        "tags": [
          "contract"
        ]
      }
    }
  },

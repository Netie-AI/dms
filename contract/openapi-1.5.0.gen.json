              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Row Predicate Sql"
          },
          "row_predicates": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Table name -> SQL boolean expression, injected per referenced table.",
            "title": "Row Predicates",
            "type": "object"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "signature": {
            "title": "Signature",
            "type": "string"
          },
          "space_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }

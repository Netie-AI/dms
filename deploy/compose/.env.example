# Install-time configuration for the appliance compose stack (BANK-04, #271).
# Copy to deploy/compose/.env (gitignored) and fill in. Nothing in this file is a
# working secret, and the compose file ships no default for one.

# REQUIRED. Left empty, `docker compose up` refuses to start. Letters, digits and
# . _ ~ - only (it is spliced into DATABASE_URL). Generate one:
#   openssl rand -hex 24
# It is applied when the dms_pg volume is first created; changing it later does
# not change the password inside an existing volume.
DMS_DB_PASSWORD=

# Certificate source for the appliance port (:8080, TLS only).
#   internal  Caddy's own CA signs the certificate. Sandbox pilot only: clients
#             must trust Caddy's root (docker compose cp ui:/data/caddy/pki/authorities/local/root.crt .).
#   files     a certificate you supply: bank CA or internal CA.
DMS_TLS_MODE=internal

# files mode only: host directory holding tls.crt (leaf plus chain, PEM) and
# tls.key (PEM). Mounted read-only. Keep it outside the repository.
# DMS_TLS_DIR=/etc/dms/tls

# The DNS name (or IP) clients type. The certificate must carry it.
DMS_TLS_HOST=localhost

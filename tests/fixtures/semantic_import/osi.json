{
  "version": "0.1.1",
  "semantic_model": {
    "name": "sales",
    "description": "Sales model",
    "ai_context": {"instructions": ["Prefer paid orders."]},
    "datasets": [
      {
        "name": "orders",
        "source": "analytics.public.orders",
        "description": "Order rows",
        "primary_key": ["order_id"],
        "fields": [
          {
            "name": "order_id",
            "description": "Order id",
            "expression": {"sql": "order_id"},
            "dimension": {"is_time": false}
          },
          {
            "name": "ordered_at",
            "description": "Order date",
            "datatype": "DATE",
            "expression": {
              "dialects": [{"dialect": "DUCKDB", "expression": "ordered_at"}]
            },
            "dimension": {"is_time": true},
            "ai_context": {"synonyms": ["order date"]}
          }
        ],
        "metrics": [
          {
            "name": "total_amount",
            "description": "Total amount",
            "expression": {"sql": "SUM(amount)"},
            "ai_context": {"synonyms": ["revenue"]}
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "orders_customers",
        "from": "orders",
        "to": "customers",
        "from_columns": ["customer_id"],
        "to_columns": ["customer_id"]
      }
    ],
    "metrics": [],
    "custom_extensions": [
      {
        "vendor_name": "DMS",
        "data": {
          "filters": [
            {
              "name": "is_paid",
              "description": "Paid rows",
              "expr": "status = 'paid'",
              "synonyms": [],
              "table": "orders"
            }
          ],
          "verified_queries": [
            {
              "name": "paid_count",
              "question": "how many paid orders",
              "sql": "SELECT COUNT(*) AS n FROM orders",
              "onboarding": true
            }
          ],
          "onboarding": ["how many paid orders"],
          "benchmarks": [
            {
              "name": "bench_count",
              "question": "bench how many orders",
              "sql": "SELECT COUNT(*) AS n FROM orders"
            }
          ],
          "unsupported": []
        }
      }
    ]
  }
}
